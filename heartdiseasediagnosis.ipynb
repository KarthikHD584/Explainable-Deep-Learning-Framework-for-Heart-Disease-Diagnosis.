plt.xlabel("False Positive Rate"); plt.ylabel("True Positive Rate")
plt.title("ROC Curve"); plt.legend()
plt.savefig(os.path.join(OUTPUT_DIR,
"roc_curve.png"))
plt.show()
 
model.save(os.path.join(OUTPUT_DIR,
"final_model.keras"))
with open(os.path.join(OUTPUT_DIR,
