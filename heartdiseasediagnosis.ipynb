def get_last_conv_layer_name(full_model, base_model):
    for layer in reversed(base_model.layers):
        if isinstance(layer, layers.Conv2D):
            return layer.name
    raise ValueError("No Conv2D layer found in base model.")
 
LAST_CONV_NAME = get_last_conv_layer_name(model, base_model)
print("Using last conv layer:", LAST_CONV_NAME)
 
grad_model = tf.keras.Model(
    inputs=model.inputs,
    outputs=[base_model.get_layer(LAST_CONV_NAME).output, model.output
]
)
 
def make_gradcam_heatmap(img_batch):
    with tf.GradientTape() as tape:
        conv_out, preds = grad_model(img_batch)
        class_channel = preds[
    : ,
    0
]
    grads = tape.gradient(class_channel, conv_out)
    pooled_grads = tf.reduce_mean(grads, axis=(0,
1,
2))
    conv_out = conv_out[
    0
]
    heatmap = conv_out @ pooled_grads[..., tf.newaxis
]
    heatmap = tf.squeeze(heatmap)
    heatmap = tf.maximum(heatmap,
0) / (tf.math.reduce_max(heatmap) + 1e-8)
    return heatmap.numpy(), preds.numpy()[
    0
][
    0
]
 
def overlay_heatmap(img_path, heatmap, alpha=0.4, save_path=None):
    img = tf.keras.utils.load_img(img_path, target_size=IMG_SIZE)
    img = tf.keras.utils.img_to_array(img)
 
    heatmap_uint8 = np.uint8(255 * heatmap)
    jet = plt.get_cmap("jet")
    jet_colors = jet(np.arange(256))[
    : ,
    : 3
]
    jet_heatmap = jet_colors[heatmap_uint8
]
    jet_heatmap = tf.keras.utils.array_to_img(jet_heatmap)
    jet_heatmap = jet_heatmap.resize((img.shape[
    1
], img.shape[
    0
]))
    jet_heatmap = tf.keras.utils.img_to_array(jet_heatmap)
 
    superimposed = jet_heatmap * alpha + img
    superimposed = tf.keras.utils.array_to_img(superimposed)
    if save_path:
        superimposed.save(save_path)
    return superimposed
 
# Grab some real file paths + true labels directly from disk for visualization
sample_dir = os.path.join(DATA_DIR,
"test") if PRESPLIT else DATA_DIR
listing_ds = tf.keras.utils.image_dataset_from_directory(
    sample_dir, image_size=IMG_SIZE, batch_size=1, label_mode="binary", shuffle=False
)
sample_paths = listing_ds.file_paths[
    : 15
]  # first 15 for a quick look
 
gradcam_dir = os.path.join(OUTPUT_DIR,
"gradcam")
os.makedirs(gradcam_dir, exist_ok=True)
 
fig, axes = plt.subplots(3,
5, figsize=(18,
10))
for ax, path in zip(axes.flat, sample_paths):
    img = tf.keras.utils.load_img(path, target_size=IMG_SIZE)
    arr = tf.keras.utils.img_to_array(img)
    batch = tf.expand_dims(arr,
0)
    heatmap, prob = make_gradcam_heatmap(batch)
    pred_class = CLASS_NAMES[
    1
] if prob >= 0.5 else CLASS_NAMES[
    0
]
    save_path = os.path.join(gradcam_dir, os.path.basename(path))
    overlay = overlay_heatmap(path, heatmap, save_path=save_path)
    ax.imshow(overlay)
    ax.set_title(f"{pred_class} ({prob:.2f})", fontsize=9)
    ax.axis("off")
plt.tight_layout()
plt.savefig(os.path.join(OUTPUT_DIR,
"gradcam_grid.png"))
plt.show()
 
print(f"Grad-CAM overlays saved to {gradcam_dir}")
