"confusion_matrix.png"))
plt.show()
 
fpr, tpr, _ = roc_curve(y_true, y_prob)
plt.figure()
plt.plot(fpr, tpr, label=f"AUC = {auc_score:.3f}")
plt.plot([
    0,
    1
],
[
    0,
