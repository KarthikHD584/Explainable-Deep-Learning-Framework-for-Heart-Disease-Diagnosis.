def inspect_data_dir(data_dir, max_depth=2):
    for root, dirs, files in os.walk(data_dir):
        depth = root.replace(data_dir,
"").count(os.sep)
        if depth > max_depth:
            continue
        indent = "  " * depth
        print(f"{indent}{os.path.basename(root) or root}/  ({len(files)} files)")


inspect_data_dir(DATA_DIR)
 
top_level = [d for d in os.listdir(DATA_DIR) if os.path.isdir(os.path.join(DATA_DIR, d))
]
PRESPLIT = set(x.lower() for x in top_level) >= {
    "train",
    "test"
}
